# Server port (Railway sets this automatically)
PORT=5000

# Set to "production" in production for static file serving
NODE_ENV=development

# SQLite database path (persistent volume on Railway: /data/data.db)
DATABASE_PATH=data.db

# Set to "true" to skip Playwright browser scraping (recommended on Railway)
# When false/omitted, also scrapes Craigslist, Thumbtack, Nextdoor, Oodle
DISABLE_BROWSER=false
