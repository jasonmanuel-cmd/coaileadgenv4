<UserControl
    x:Class="CoaiLeadMonitor.Controls.StatTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardStyle}" MinWidth="160" MinHeight="100">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
            <TextBlock x:Name="ValueText" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}"/>
            <TextBlock x:Name="LabelText" FontSize="14" Opacity="0.7"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
