<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CoaiLeadMonitor.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CoaiLeadMonitor.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24,16" Spacing="12">
        <TextBlock Text="About" Style="{StaticResource PageHeaderStyle}"/>
        <TextBlock Text="COAI Lead Monitor" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Version 1.0.0" Opacity="0.7"/>
        <TextBlock TextWrapping="Wrap" MaxWidth="500" Opacity="0.8"
                   Text="Desktop client for monitoring and managing leads from the COAI lead tracker API. Connects to a running instance of the lead-monitor Express backend."/>
        <TextBlock Text="Backend URL: http://localhost:5000" Opacity="0.5" Margin="0,12,0,0"/>
        <TextBlock Text="Built with WinUI 3 and .NET 10" Opacity="0.5"/>
    </StackPanel>
</Page>
